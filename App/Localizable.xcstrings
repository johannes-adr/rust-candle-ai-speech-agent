    "ownVoice.honest": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Stimme klingt so, wie Sie sie aufgenommen haben. Sprechen Sie fröhlich, klingt es fröhlich. Das Tempo können Sie trotzdem ändern."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua voz soa como a gravou. Se falar com alegria, soará alegre. Mesmo assim, pode alterar a velocidade."
          }
        }
      }
    },
