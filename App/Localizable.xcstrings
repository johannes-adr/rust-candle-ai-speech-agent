    "camera.shoot.error": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das hat nicht geklappt. Bitte versuchen Sie es noch einmal."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não correu bem. Tente outra vez."
          }
        }
