    "comingSoon.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bald können Sie hier mit Ihrer eigenen Stimme vorlesen lassen. Bis dahin wählen Sie bitte eine der fertigen Stimmen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Em breve poderá aqui ouvir a leitura com a sua própria voz. Até lá, escolha uma das vozes prontas."
          }
        }
      }
    },
    "comingSoon.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das kommt bald"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto chega em breve"
          }
        }
      }
    },
