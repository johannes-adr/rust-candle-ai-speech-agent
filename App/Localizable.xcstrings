    "helper.quality.info": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemessen auf dem M4: „Etwas genauer“ braucht etwa 12 % mehr Zeit und etwa 0,4 GB mehr Arbeitsspeicher. Ob man den Unterschied hört, ist nicht belegt; im Zweifel „Schneller“ lassen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Medido no M4: “Um pouco mais preciso” demora cerca de 12 % mais e usa cerca de 0,4 GB a mais de memória. Não está provado que se ouça a diferença; em caso de dúvida, deixe “Mais rápido”."
          }
        }
      }
    },
