    "camera.waiting.helper": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird nichts gefunden? Dann fragen Sie bitte Ihren Helfer. Das iPhone muss mit demselben Apple-Konto angemeldet sein wie dieser Computer."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não encontra nada? Peça ajuda ao seu ajudante. O iPhone tem de ter a mesma conta Apple que este computador."
          }
        }
      }
    },
    "camera.waiting.searching": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird gesucht …"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A procurar …"
          }
        }
      }
    },
    "camera.waiting.step1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Nehmen Sie Ihr iPhone zur Hand und entsperren Sie es."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Pegue no seu iPhone e desbloqueie-o."
          }
        }
      }
    },
    "camera.waiting.step2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Legen Sie es in die Nähe des Computers."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Coloque-o perto do computador."
          }
        }
      }
    },
    "camera.waiting.step3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Warten Sie einen Moment. Es meldet sich von selbst."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Aguarde um momento. Ele liga-se sozinho."
          }
        }
      }
    },
    "camera.waiting.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr iPhone wird gesucht …"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A procurar o seu iPhone …"
          }
        }
      }
    },
