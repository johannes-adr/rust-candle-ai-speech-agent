    "camera.review.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Zeilen sollen scharf und vollständig zu sehen sein."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as linhas devem estar nítidas e completas."
          }
        }
      }
    },
    "camera.review.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist die Seite gut zu lesen?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A página lê-se bem?"
          }
        }
      }
    },
    "camera.review.yes": {
      "extractionState": "manual",
