      }
    },
    "problem.generic": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Erstellen ist etwas schiefgegangen. Was schon fertig war, ist gespeichert. Bitte versuchen Sie es noch einmal."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo correu mal ao criar. O que já estava pronto ficou guardado. Por favor, tente outra vez."
          }
        }
      }
    },
    "problem.locked": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei ist mit einem Kennwort geschützt. Ich kann sie leider nicht öffnen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este ficheiro está protegido por palavra-passe. Infelizmente não o consigo abrir."
          }
        }
      }
    },
    "problem.noText": {
