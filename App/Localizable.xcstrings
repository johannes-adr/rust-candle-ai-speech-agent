    "ownVoice.mic.steps": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So geht es: „Einstellungen öffnen“ drücken, dann „Datenschutz und Sicherheit“, dann „Mikrofon“ und dort „Vorleser“ einschalten. Danach kommen Sie hierher zurück und drücken „Nochmal versuchen“."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Assim: carregue em «Abrir definições», depois «Privacidade e segurança», depois «Microfone» e ligue lá o «Leitor». Depois volte aqui e carregue em «Tentar outra vez»."
          }
        }
      }
    },
    "ownVoice.mic.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit Vorleser Ihre Stimme aufnehmen kann, muss es das Mikrofon benutzen dürfen. Das haben Sie bisher nicht erlaubt. Das ist nicht schlimm, Sie können es jetzt ändern."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para o Leitor poder gravar a sua voz, tem de poder usar o microfone. Até agora não o permitiu. Não faz mal, pode mudar isso agora."
          }
        }
      }
    },
    "ownVoice.mic.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mikrofon ist ausgeschaltet"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O microfone está desligado"
          }
        }
      }
    },
