    "help.none": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier steht noch kein Helfer. Bitten Sie jemanden, im Menü „Vorleser › Einstellungen“ einen Namen und eine Telefonnummer einzutragen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há ninguém indicado. Peça a alguém para escrever um nome e um número de telefone no menu «Leitor › Definições»."
          }
        }
      }
    },
