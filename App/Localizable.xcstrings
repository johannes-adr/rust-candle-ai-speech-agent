    "camera.shoot.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legen Sie die Seite hin und halten Sie das iPhone darüber"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
