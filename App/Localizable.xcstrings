    "camera.partial.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei diesen Seiten konnte ich keinen Text erkennen: %@. Sie fehlen beim Vorlesen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nestas páginas não consegui reconhecer texto: %@. Vão faltar na leitura."
          }
        }
      }
    },
    "camera.partial.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht alle Seiten waren lesbar"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem todas as páginas se conseguiram ler"
          }
        }
      }
    },
    "camera.problem.noText": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf den Fotos konnte ich keinen Text lesen. Bitte nehmen Sie die Seite bei mehr Licht auf und halten Sie das iPhone ruhig."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não consegui ler texto nas fotografias. Fotografe a página com mais luz e mantenha o iPhone firme."
          }
        }
      }
    },
    "camera.reading.cancel": {
