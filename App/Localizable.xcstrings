    "books.unfinished": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nicht fertig – hier tippen, um weiterzumachen"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não está pronto – toque aqui para continuar"
          }
        }
      }
    },
    "camera.card.sub": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Brief oder Buchseite hinlegen und mit dem iPhone aufnehmen"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pôr a carta ou a página do livro em cima da mesa e fotografar com o iPhone"
          }
        }
      }
    },
    "camera.card.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vom iPhone fotografieren"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografar com o iPhone"
          }
        }
      }
    },
    "camera.denied.open": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen öffnen"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir as definições"
          }
        }
      }
    },
    "camera.denied.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit Fotos gemacht werden dürfen, muss die Kamera für Vorleser erlaubt sein. Ihr Helfer kann das in den Systemeinstellungen unter „Datenschutz & Sicherheit“ und „Kamera“ einschalten."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para poder tirar fotografias, a câmara tem de estar autorizada para o Leitor. O seu ajudante pode ativá-la nas Definições do Sistema, em “Privacidade e segurança” e “Câmara”."
          }
        }
      }
    },
    "camera.denied.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera ist nicht erlaubt"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A câmara não está autorizada"
          }
        }
      }
    },
    "camera.discard.no": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nein, weitermachen"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não, continuar"
          }
        }
      }
    },
    "camera.discard.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die bisher aufgenommenen Seiten gehen dann verloren."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As páginas fotografadas até agora perdem-se."
          }
        }
      }
    },
    "camera.discard.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos verwerfen?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Descartar as fotografias?"
          }
        }
      }
    },
    "camera.discard.yes": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja, verwerfen"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sim, descartar"
          }
        }
      }
