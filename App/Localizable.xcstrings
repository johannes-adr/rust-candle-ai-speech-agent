    "problem.fileMissing": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei dieses Hörbuchs wurde nicht gefunden. Vielleicht wurde sie verschoben."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O ficheiro deste audiolivro não foi encontrado. Talvez tenha sido movido."
          }
