    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorleser nimmt Ihre Stimme auf, damit vorgelesen werden kann wie Sie sprechen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Leitor grava a sua voz para que a leitura possa soar como a sua fala."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorleser prüft damit, ob der Lesetext bei Ihrer Aufnahme vorgelesen wurde."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Leitor verifica assim se o texto foi lido na sua gravação."
          }
        }
      }
    }
  }
}
